# 数据库排查配置（scripts/db_query.py 使用）
#
# 复制为 .env.db 后填写。.env.db 已被 .gitignore 忽略，不会提交。
# 换成其他环境只需改这个文件，代码不用动。
#
# 说明：本文件不参与应用启动配置。主配置 src/config.py 的 Settings
# 是 extra=forbid 的严格模型，多出未声明键会导致启动失败，
# 所以排查用的连接信息单独放这里。

# 主库（默认数据源，default）
SIT_DB_HOST=storesitmaster-m.dbsit.sfcloud.local
SIT_DB_PORT=3306
SIT_DB_USER=sf_server
SIT_DB_PASSWORD=
SIT_DB_NAME=united_store

# 分片库（us0..us5），库名为 {前缀}_{00..05}
SIT_DB_SHARD_HOST=storesit1s-m.dbsit.sfcloud.local
SIT_DB_SHARD_NAME_PREFIX=united_store
