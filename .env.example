# 钉钉智能问答机器人 — 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 钉钉配置 ──
DINGTALK_APP_KEY=your_app_key_here
DINGTALK_APP_SECRET=your_app_secret_here
DINGTALK_BOT_CODE=your_bot_code_here

# ── LLM 供应商选择 ──
# local = 本地 Ollama；glm = 智谱开放平台（远程 API）
# 启动时读取；运行时可调 POST /api/llm/switch 临时切换，重启后以此值为准。
LLM_PROVIDER=local

# ── Ollama 配置 (可选,有默认值) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT=120
OLLAMA_MAX_CONCURRENT=2
# 思考模式: qwen3.5 等模型会先输出推理过程并占用 num_predict 配额。
# 问答场景建议设为 false，避免正式回答为空。
OLLAMA_THINK=false

# ── 智谱 GLM 配置（远程 API，可选）──
# 获取 API Key: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 实测（2026-11）：glm-4.7-flash / glm-4.5-flash 为免费模型，高峰期常返回
# 429「该模型当前访问量过大」，且 glm-4.7-flash 默认开启思考模式会占满输出配额。
# glm-4-flash-250414 响应稳定，作为默认。
GLM_MODEL=glm-4-flash-250414
# 主模型被限流(429)时按顺序自动降级，逗号分隔；留空则不降级。
# glm-4.7-flash 是 30B SOTA 免费模型，能力最强但高峰期限流严重，适合放这里兜底。
GLM_FALLBACK_MODELS=glm-4.7-flash,glm-4.5-flash
# 思考模式：glm-4.7-flash 等默认带推理会占满输出配额，问答建议关闭
GLM_THINKING=false
GLM_EMBEDDING_MODEL=embedding-3
# embedding-3 支持 256-2048 维，须与本地索引分开（不同集合）
GLM_EMBEDDING_DIMENSIONS=1024
GLM_TIMEOUT=120
GLM_MAX_CONCURRENT=4

# ── RAG 配置 (可选,有默认值) ──
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=knowledge_base
# GLM embedding-3 专用集合（与本地 bge-m3 索引隔离）
CHROMA_COLLECTION_GLM=knowledge_base_glm
RAG_TOP_K=5
# 以下阈值为余弦相似度(0-1)，已按 bge-m3 实测校准:
# 相关问句 top-1 约 0.51~0.65，无关问句 top-1 约 0.31~0.37
RAG_THRESHOLD_STANDARD=0.52
RAG_THRESHOLD_PROCESS=0.48
RAG_THRESHOLD_FLEXIBLE=0.45
RAG_THRESHOLD_GENERAL=0.45
RAG_SPARSE_MAX_KEYWORDS=8

# ── 生成参数 (可选,有默认值) ──
LLM_TEMPERATURE_STANDARD=0.3
LLM_TEMPERATURE_FLEXIBLE=0.7
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192

# ── 数据库 (可选,有默认值) ──
ANALYTICS_DB_PATH=./data/analytics.db

# ── 代码解析 (可选,有默认值) ──
PARSER_DEFAULT_PROJECT_ROOT=

# ── 会话配置 (可选,有默认值) ──
SESSION_MAX_HISTORY=10
SESSION_TTL_SECONDS=300

# ── 限流配置 (可选,有默认值) ──
RATE_LIMIT_PER_USER=3

# ── 应用配置 (可选,有默认值) ──
APP_NAME=dingtalk-qa-bot
APP_ENV=development
LOG_LEVEL=INFO
